NODE_ENV=development
PORT=3004
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SESSION_SECRET=REPLACE_WITH_THE_EXACT_32_PLUS_CHARACTER_SECRET_USED_BY_IDENTITY_AND_OTHER_SERVICES
FRONTEND_ORIGIN=http://localhost:8788
COOKIE_SECURE=false
SERVICE_SHARED_SECRET=REPLACE_WITH_THE_EXACT_SHARED_SECRET_USED_BY_EDITORIAL_AND_ARTICLE
ARTICLE_SERVICE_URL=http://localhost:3001
TURNSTILE_SECRET_KEY=REPLACE_FOR_REAL_VOTE_CHALLENGES
# Optional: sentiment analysis runs only if URL and token are configured.
HF_INFERENCE_URL=
HF_TOKEN=
# Optional: enforce a specific challenge for feedback too.
REQUIRE_TURNSTILE_FOR_VOTES=true

# AWS (Floci locally). "test" keys are Floci's fake keys, not real secrets.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# Keys of the least-privilege IAM user "search-analytics-service" (see infra/setup-floci.sh)
AWS_ACCESS_KEY_ID=REPLACE_WITH_SEARCH_SERVICE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SEARCH_SERVICE_SECRET_KEY
DYNAMODB_COUNTERS_TABLE=supporthub-search-counters

CLOUDWATCH_NAMESPACE=SupportHub/Search
METRICS_FLUSH_MS=10000

S3_EXPORT_BUCKET=supporthub-search-analytics-exports
# Requests per IP per 15 minutes (keep 300 normally; raise only for local load tests)
RATE_LIMIT_MAX=300
# Max database connections per service instance (Neon pooled endpoint)
DB_POOL_MAX=5
POORLY_RATED_MIN_VOTES=3
# Short caches (0 = off)
SEARCH_CACHE_MS=5000
ANALYTICS_CACHE_MS=15000

# Editorial Service (automatic re-review flags from unhelpful votes)
EDITORIAL_SERVICE_URL=http://localhost:3002
