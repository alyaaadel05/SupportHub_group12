# Editorial Service
NODE_ENV=development
PORT=3002

# Database
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Optional fallback if DATABASE_URL_POOLED is not configured
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Shared session configuration
# Must match Identity and Article Service
SESSION_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_USED_BY_IDENTITY_AND_ARTICLE

# Frontend configuration
FRONTEND_ORIGIN=http://localhost:8080
COOKIE_SECURE=false

# Service-to-service authentication
# Must match the shared secret configured in Article and Search
SERVICE_SHARED_SECRET=REPLACE_WITH_THE_SHARED_SERVICE_SECRET

# Dependent services
ARTICLE_SERVICE_URL=http://localhost:3001
SEARCH_SERVICE_URL=http://localhost:3004

# Internal scheduled endpoint
# Use a separate random secret of at least 32 characters
CRON_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Local Floci SQS configuration
AWS_REGION=us-east-1
SQS_ENDPOINT_URL=http://localhost:4566
ARTICLE_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/supporthub-article-events

# Local Floci credentials only
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS consumer configuration
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=60
