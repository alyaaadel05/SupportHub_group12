NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SESSION_SECRET=REPLACE_WITH_THE_SAME_32_PLUS_CHARACTER_SECRET_AS_IDENTITY
FRONTEND_ORIGIN=http://localhost:8788
COOKIE_SECURE=false
# For browser session cookies forwarded by Pages proxy, don't set a Domain attribute.
SERVICE_SHARED_SECRET=REPLACE_WITH_A_DIFFERENT_32_PLUS_CHARACTER_INTERNAL_SECRET
# Optional for higher Stack Exchange API quota; leave blank for initial testing
STACK_EXCHANGE_KEY=
