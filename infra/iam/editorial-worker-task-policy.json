{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeArticleEventsOnly",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility", "sqs:GetQueueAttributes", "sqs:GetQueueUrl"],
      "Resource": [
        "arn:aws:sqs:us-east-1:000000000000:supporthub-article-events",
        "arn:aws:sqs:us-east-1:000000000000:supporthub-article-events-production"
      ]
    },
    {
      "Sid": "PublishPublicationEventsOnly",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:000000000000:supporthub-editorial-publication-events"
    },
    {
      "Sid": "ReadWorkerSecretsOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:supporthub/shared/database-*",
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:supporthub/shared/service-hmac-*"
      ]
    }
  ]
}
