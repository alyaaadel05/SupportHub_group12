
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListArticleBackupObjects",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::supporthub-article-backups"
    },
    {
      "Sid": "ReadWriteArticleBackups",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::supporthub-article-backups/articles/*"
    }
  ]
}
