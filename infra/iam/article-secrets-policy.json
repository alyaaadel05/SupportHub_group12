{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadArticleAndSharedSecretsOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": ["arn:aws:secretsmanager:us-east-1:000000000000:secret:supporthub/article/runtime-config-*", "arn:aws:secretsmanager:us-east-1:000000000000:secret:supporthub/shared/session-*", "arn:aws:secretsmanager:us-east-1:000000000000:secret:supporthub/shared/service-hmac-*", "arn:aws:secretsmanager:us-east-1:000000000000:secret:supporthub/shared/database-*"]
    }
  ]
}
